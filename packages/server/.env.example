# 复制成 packages/server/.env 并改成自己的连接信息。已经设置的环境变量优先于这个文件。

# PostgreSQL：账号、角色等需要长期保存的数据。表结构在启动时按 migrations/ 自动创建。
DATABASE_URL=postgres://mmo:换成你的密码@localhost:5432/mmo

# Redis：登录会话和登录失败次数。
REDIS_URL=redis://localhost:6379

# 可选项
# PORT=8080
# 监听的地址，不设置时监听所有网卡。前面有反向代理时设成 ::1 或 127.0.0.1，不让外面直接连进来。
# HOST=::1
# 构建好的客户端目录（pnpm build 的产物）。设置后服务器同时提供页面；开发时页面由 Vite 提供，不用设置。
# STATIC_DIR=../client/dist
# MAP_SEED=20261127
# MAX_PLAYERS=2000
